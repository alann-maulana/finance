rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fungsi bantuan untuk mengecek apakah user sudah login
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Fungsi bantuan untuk mengecek apakah user berada di vendor yang sama
    function isSameVendor(targetUserId) {
      let currentUserVendorId = get(/databases/$(database)/documents/vendorMembers/$(request.auth.uid)).data.get('vendorId', null);
      let targetUserVendorId = get(/databases/$(database)/documents/vendorMembers/$(targetUserId)).data.get('vendorId', null);
      return currentUserVendorId != null && currentUserVendorId == targetUserVendorId && targetUserVendorId != null;
    }

    // Fungsi bantuan: cek apakah user adalah member dari vendor tertentu
    function isVendorMember(vendorId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/vendorMembers/$(request.auth.uid)).data.get('vendorId', null) == vendorId;
    }

    // ==========================================
    // 1. Collection: vendors
    // ==========================================
    match /vendors/{vendorId} {
      // Semua user yang login bisa membaca (diperlukan saat input kode unik untuk bergabung)
      allow read: if isAuthenticated();
      // User hanya bisa membuat vendor dengan createdBy miliknya sendiri
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false; // Vendor tidak boleh diedit atau dihapus sembarangan
    }

    // ==========================================
    // 2. Collection: vendorMembers
    // ==========================================
    match /vendorMembers/{memberId} {
      // User bisa melihat list member
      allow read: if isAuthenticated();
      // User bisa membuat data join (diri sendiri)
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // History join tidak boleh diedit
    }

    // ==========================================
    // 3. Collection: periodBalances (Master Saldo)
    // ==========================================
    match /periodBalances/{balanceId} {
      // User bisa membaca dan menulis (diperlukan untuk update transaksional saldo)
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      // Catatan: Di production skala besar, Anda bisa menggunakan exists() 
      // untuk memvalidasi apakah user merupakan bagian dari vendor tersebut.
    }

    // ==========================================
    // 4. Collection: users (User Profile & Verified Flag)
    // ==========================================
    match /users/{userId} {
      // User hanya bisa membaca dokumen miliknya sendiri, atau member lain di vendor yang sama
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isSameVendor(userId)
      );
      // User bisa membuat dokumen profil dirinya sendiri (first login)
      allow create: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.verified == false;
      // User bisa update email dan name, tapi TIDAK boleh mengubah field `verified`
      // Field `verified` hanya bisa diubah melalui Firebase Console (admin)
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.verified == resource.data.verified;
      allow delete: if false;
    }

    // ==========================================
    // 5. Collection: transactions (Dana Masuk / Keluar)
    // ==========================================
    match /transactions/{transactionId} {
      // User bisa membaca transaksi
      allow read: if isAuthenticated();
      // User hanya bisa membuat transaksi atas namanya sendiri (createdBy = uid)
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      // Semua member vendor yang sama bisa edit/hapus transaksi di vendor mereka
      allow update, delete: if isVendorMember(resource.data.vendorId);
    }

    // ==========================================
    // 6. Collection: categories (Kategori Transaksi)
    // ==========================================
    match /categories/{categoryId} {
      // Semua user yang sudah login bisa membaca kategori
      allow read: if isAuthenticated();
      // User bisa membuat kategori untuk vendornya sendiri
      allow create: if isAuthenticated()
                    && request.resource.data.created_by == request.auth.uid
                    && request.resource.data.vendorId is string;
      // Kategori tidak bisa diedit/dihapus sembarangan (kelola via Console)
      allow update, delete: if false;
    }
  }
}